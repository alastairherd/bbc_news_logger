---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Ask the archive | BBC News Analyser"
  description="Search BBC News coverage by meaning and ask for an answer that cites the matching articles."
  current="signals"
>
  <div class="page">
    <div class="page-head">
      <h1>Ask the archive</h1>
      <p>Search stories by meaning, then ask for an answer that cites only the matching BBC articles. Search runs in your browser.</p>
    </div>

    <section class="status-bar" aria-label="Search status">
      <dl>
        <div><dt>Labelled</dt><dd id="coverage">—</dd></div>
        <div><dt>Searchable stories</dt><dd id="document-count">—</dd></div>
        <div><dt>Search model</dt><dd id="model-state" data-state="idle"><span class="status-dot" aria-hidden="true"></span><span id="model-message" role="status">Loads when you search</span></dd></div>
      </dl>
    </section>

    <form class="ask-form" id="semantic-search-form" role="search">
      <label class="ask-label" for="semantic-query">Question, event, or idea</label>
      <div class="ask-row">
        <span class="input-icon">
          <svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.25" /><path d="m10.25 10.25 3.25 3.25" /></svg>
          <input id="semantic-query" type="search" placeholder="How has housing policy affected renters?" autocomplete="off" />
        </span>
        <button class="button" name="mode" value="ask" type="submit">Ask the archive</button>
        <button class="button secondary" name="mode" value="search" type="submit">Find sources only</button>
      </div>
      <progress id="model-progress" max="100" value="0" aria-label="Search model download progress" hidden></progress>
      <div class="ask-filters">
        <div class="filter-field">
          <label for="semantic-surface">List</label>
          <select id="semantic-surface"><option value="all">Both lists</option><option value="front_page">Front page</option><option value="most_read">Most Read</option></select>
        </div>
        <div class="filter-field">
          <label for="semantic-topic">Topic</label>
          <select id="semantic-topic"><option value="all">All topics</option></select>
        </div>
        <div class="filter-field">
          <label for="semantic-form">Story form</label>
          <select id="semantic-form"><option value="all">All forms</option></select>
        </div>
        <div class="filter-field">
          <label for="research-depth">Answer depth</label>
          <select id="research-depth" aria-describedby="depth-help">
            <option value="off">Fast</option>
            <option value="high">Reasoned</option>
          </select>
          <small id="depth-help">Reasoned answers take longer and use more tokens.</small>
        </div>
      </div>
    </form>

    <p class="search-summary" id="search-summary" aria-live="polite">The first search downloads the story index and a small query model to this browser.</p>


    <section class="answer" id="research-answer" aria-live="polite" hidden></section>

    <section class="sources" aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="rule-heading">Sources</h2>
      <ol class="source-list" id="semantic-results">
        <li class="empty">Matching stories appear here, numbered so the answer can cite them.</li>
      </ol>
    </section>
  </div>

  <script>
    import { titleParts } from "../lib/titles";

    interface Manifest { semantics?: { signalCount: number; articleVersionCount: number; coveragePercent: number; recurringEventCount: number; searchDocumentCount?: number } }
    interface SearchDocument { story_id: string; title: string; url: string; fetched_at: string; surfaces: string[]; best_position: number | null; summary: string; topic: string; themes: string[]; story_form: string; event_type: string }
    interface SearchResult { document: SearchDocument; score: number }
    interface ResearchFinding { claim: string; sources: number[] }
    interface ResearchResponse { answer: string; findings: ResearchFinding[]; limitations: string; model: string; cached: boolean; reasoning?: string; usage?: { promptTokens: number; completionTokens: number; costUsd: number } }

    const SURFACE_NAME: Record<string, string> = { front_page: "Front page", most_read: "Most Read" };
    const base = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
    const researchApi = import.meta.env.PUBLIC_RESEARCH_API_URL || "";
    const number = new Intl.NumberFormat("en-GB");
    const date = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
    const externalIcon = `<svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3h7v7M13 3 4 12"/></svg>`;
    const alertIcon = `<svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.25"/><path d="M8 4.75v4M8 11v.25"/></svg>`;
    let semanticReady = false;
    let semanticStarted = false;
    let pendingSearch = false;
    let askAfterSearch = false;
    let lastSearchResults: SearchResult[] = [];
    let requestId = 0;

    const escape = (value: unknown): string => {
      const entities: Record<string, string> = { "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;" };
      return String(value).replace(/[&<>'"]/g, (character) => entities[character] ?? character);
    };
    const element = (selector: string): HTMLElement => { const result = document.querySelector<HTMLElement>(selector); if (!result) throw new Error(`Missing element: ${selector}`); return result; };
    const control = (selector: string): HTMLInputElement | HTMLSelectElement => { const result = document.querySelector<HTMLInputElement | HTMLSelectElement>(selector); if (!result) throw new Error(`Missing control: ${selector}`); return result; };
    const label = (value: string) => value.replaceAll("_", " ");
    const headline = (title: string, url: string) => {
      const { live, text } = titleParts(title, url);
      return `${live ? `<span class="live-label">Live</span> ` : ""}${escape(text)}`;
    };

    let semanticWorker: Worker | null = null;
    let semanticWorkerLoad: Promise<Worker> | null = null;

    function getSemanticWorker(): Promise<Worker> {
      if (semanticWorker) return Promise.resolve(semanticWorker);
      if (semanticWorkerLoad) return semanticWorkerLoad;
      semanticWorkerLoad = import("../workers/semantic-search.worker?worker").then(({ default: SemanticSearchWorker }) => {
        semanticWorker = new SemanticSearchWorker();
        semanticWorker.addEventListener("message", handleSemanticMessage);
        return semanticWorker;
      });
      return semanticWorkerLoad;
    }

    function startSemanticSearch() {
      if (semanticStarted) return;
      semanticStarted = true;
      const bar = document.querySelector<HTMLProgressElement>("#model-progress");
      if (bar) bar.hidden = false;
      setModelState("Downloading the story index…");
      void getSemanticWorker().then((worker) => worker.postMessage({
          type: "init",
          metadataUrl: new URL(`${base}data/semantic-documents.json`, location.href).href,
          vectorsUrl: new URL(`${base}data/semantic-vectors.i8`, location.href).href,
          loadModel: true,
        })).catch(() => {
          semanticStarted = false;
          setModelState("Could not start", "error");
          element("#search-summary").textContent = "This browser could not start the search worker. Refresh the page to try again.";
        });
    }

    function setModelState(message: string, state: "loading" | "ready" | "error" = "loading") {
      element("#model-message").textContent = message;
      element("#model-state").dataset.state = state;
    }

    function fillOptions(selector: string, values: string[]) {
      const select = control(selector) as HTMLSelectElement;
      const initial = select.options[0]?.outerHTML ?? "";
      select.innerHTML = `${initial}${values.filter((value) => value && value !== "unlabelled").map((value) => `<option value="${escape(value)}">${escape(label(value))}</option>`).join("")}`;
    }

    function submitSemanticSearch(ask = false) {
      const query = control("#semantic-query").value.trim();
      if (!query) { control("#semantic-query").focus(); return; }
      askAfterSearch = ask;
      if (!semanticReady) {
        pendingSearch = true;
        startSemanticSearch();
        element("#search-summary").textContent = ask ? "Your question will run as soon as the search model has loaded." : "Your search will run as soon as the search model has loaded.";
        return;
      }
      pendingSearch = false;
      requestId += 1;
      element("#search-summary").textContent = `Comparing your ${ask ? "question" : "search"} with ${number.format(Number(element("#model-state").dataset.count ?? 0))} stories…`;
      element("#semantic-results").innerHTML = `<li class="skeleton skeleton-list" aria-hidden="true"><i></i><i></i><i></i></li>`;
      if (ask) {
        const panel = element("#research-answer"); panel.hidden = false;
        panel.innerHTML = `<p class="answer-state">Finding the strongest sources before asking for an answer…</p>`;
      }
      void getSemanticWorker().then((worker) => worker.postMessage({ type: "search", requestId, query, filters: { surface: control("#semantic-surface").value, topic: control("#semantic-topic").value, storyForm: control("#semantic-form").value } }));
      const params = new URLSearchParams(location.search); params.set("q", query); history.replaceState(null, "", `${location.pathname}?${params}`);
    }

    function renderSearchResults(results: SearchResult[], mode: string) {
      const query = control("#semantic-query").value.trim();
      lastSearchResults = results;
      element("#search-summary").textContent = results.length
        ? `${results.length} closest matches for “${query}”${mode === "semantic" ? "" : ", using keyword matching because the search model is unavailable"}.`
        : `No stories matched “${query}” with these filters.`;
      element("#semantic-results").innerHTML = results.length ? results.map(({ document, score }, index) => `
        <li class="source" id="source-${index + 1}">
          <span class="source-number" aria-label="Source ${index + 1}">${index + 1}</span>
          <div>
            <h3><a href="${escape(document.url)}">${headline(document.title, document.url)}<span class="sr-only"> (opens BBC News)</span></a></h3>
            <p class="story-meta"><span>${date.format(new Date(document.fetched_at))}</span>${document.surfaces.length ? `<span>${document.surfaces.map((surface) => `<span class="list-tag list-${surface}">${SURFACE_NAME[surface] ?? escape(surface)}</span>`).join(" ")}</span>` : `<span>Article archive only</span>`}<span>${escape(label(document.story_form))}</span><span>Similarity ${score.toFixed(2)}</span></p>
            ${document.summary ? `<p class="source-summary">${escape(document.summary)}</p>` : ""}
            <p class="story-meta"><span>${escape(label(document.topic))}</span>${document.themes.slice(0, 4).map((theme) => `<span>${escape(label(theme))}</span>`).join("")}<span><a class="meta-link" href="${base}explore/?story=${encodeURIComponent(document.story_id)}">Archive record</a></span></p>
          </div>
        </li>`).join("") : `<li class="empty">Try broader wording or clear a filter.</li>`;
      if (askAfterSearch) {
        askAfterSearch = false;
        if (results.length) void askArchive();
        else element("#research-answer").hidden = true;
      }
    }

    function sourceLinks(sources: number[]): string {
      return sources.map((source) => lastSearchResults[source - 1]
        ? `<a class="citation" href="#source-${source}" aria-label="Source ${source}">${source}</a>`
        : "").join("");
    }

    function citedText(value: string): string {
      return escape(value).replace(/\[(\d+)\]/g, (marker, index) => {
        const source = Number(index);
        return lastSearchResults[source - 1] ? sourceLinks([source]) : marker;
      });
    }

    function reasoningDepth(): "off" | "high" {
      return control("#research-depth").value === "high" ? "high" : "off";
    }

    function reasoningLabel(value: string): string {
      return value === "high" ? "Reasoned" : "Fast";
    }

    async function requestResearch(query: string, evidence: Record<string, unknown>[], signal: AbortSignal): Promise<ResearchResponse> {
      if (!researchApi) throw new Error("The shared answer service is not configured for this site.");
      const response = await fetch(researchApi, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ query, evidence, reasoning: reasoningDepth() }),
        signal,
      });
      const value = await response.json().catch(() => ({})) as ResearchResponse & { detail?: string };
      if (!response.ok) throw new Error(value.detail || `The answer service returned ${response.status}.`);
      return value;
    }

    async function askArchive() {
      const query = control("#semantic-query").value.trim();
      const panel = element("#research-answer");
      if (!query || !lastSearchResults.length) return;
      panel.hidden = false;
      const depth = reasoningDepth();
      panel.innerHTML = `<p class="answer-state">Reading ${Math.min(20, lastSearchResults.length)} sources in ${reasoningLabel(depth).toLowerCase()} mode…</p>`;
      const evidence = lastSearchResults.slice(0, 20).map(({ document, score }) => ({
        title: titleParts(document.title, document.url).text, url: document.url, date: document.fetched_at,
        summary: document.summary, topic: document.topic, themes: document.themes,
        story_form: document.story_form, event_type: document.event_type, similarity: score,
      }));
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 90_000);
      try {
        const value = await requestResearch(query, evidence, controller.signal);
        const findings = value.findings?.length
          ? `<h3>Findings</h3><ol class="answer-findings">${value.findings.map((finding) => `<li><span>${escape(finding.claim)}</span><span class="citations">${sourceLinks(finding.sources)}</span></li>`).join("")}</ol>`
          : "";
        const cost = value.usage?.costUsd ? ` · $${value.usage.costUsd.toFixed(5)}` : "";
        panel.innerHTML = `<div class="answer-head"><h2>Cited answer</h2><p>${escape(value.model)} · ${reasoningLabel(value.reasoning ?? depth)}${value.cached ? " · cached" : cost}</p></div>
          <p class="answer-copy">${citedText(value.answer)}</p>${findings}
          ${value.limitations ? `<p class="answer-limit"><strong>Limits.</strong> ${escape(value.limitations)}</p>` : ""}
          <p class="source-note">Generated from the numbered sources below and can be wrong. Check each claim against its source. Model reasoning is neither stored nor shown.</p>`;
      } catch (error) {
        const message = error instanceof DOMException && error.name === "AbortError" ? "The answer service did not respond within 90 seconds." : error instanceof Error ? error.message : "The answer service is unavailable.";
        panel.innerHTML = `<div class="error-panel">${alertIcon}<div><p><strong>Error:</strong> no answer was generated. ${escape(message)}</p>
          <p>The sources below are still available. Try again later.</p>
          <button class="button secondary" id="retry-research" type="button">Try again</button></div></div>`;
        document.querySelector<HTMLButtonElement>("#retry-research")?.addEventListener("click", () => void askArchive());
      } finally {
        window.clearTimeout(timeout);
      }
    }

    function handleSemanticMessage(event: MessageEvent) {
      const message = event.data;
      if (message.type === "status") setModelState(message.message);
      if (message.type === "index-ready") {
        element("#model-state").dataset.count = String(message.count);
        fillOptions("#semantic-topic", message.topics);
        fillOptions("#semantic-form", message.storyForms);
        element("#search-summary").textContent = `${number.format(message.count)} stories indexed; loading the query model.`;
      }
      if (message.type === "model-progress") {
        const progress = Number(message.progress ?? (message.total ? message.loaded / message.total * 100 : 0));
        const bar = document.querySelector<HTMLProgressElement>("#model-progress"); if (bar && Number.isFinite(progress)) bar.value = Math.max(0, Math.min(100, progress));
        setModelState(`Loading${progress ? ` · ${Math.round(progress)}%` : ""}`);
      }
      if (message.type === "model-ready") {
        semanticReady = true; setModelState("Ready", "ready");
        const bar = document.querySelector<HTMLProgressElement>("#model-progress"); if (bar) bar.hidden = true;
        element("#search-summary").textContent = `${number.format(Number(element("#model-state").dataset.count ?? 0))} stories ready to search by meaning.`;
        if (pendingSearch || control("#semantic-query").value.trim()) submitSemanticSearch(askAfterSearch);
      }
      if (message.type === "model-error") {
        semanticReady = true; setModelState("Keyword matching only", "error");
        element("#search-summary").textContent = "The story index loaded, but the query model did not, so searches use keyword matching.";
        if (pendingSearch) submitSemanticSearch(askAfterSearch);
      }
      if (message.type === "search-results" && message.requestId === requestId) renderSearchResults(message.results, message.mode);
      if (message.type === "fatal-error") { setModelState("Unavailable", "error"); element("#search-summary").textContent = message.message; }
      if (message.type === "search-error" && message.requestId === requestId) { element("#search-summary").textContent = message.message; element("#semantic-results").innerHTML = `<li class="empty">The search could not be completed. Try again.</li>`; }
    }

    element("#semantic-search-form").addEventListener("submit", (event) => {
      event.preventDefault();
      const submitter = (event as SubmitEvent).submitter as HTMLButtonElement | null;
      submitSemanticSearch(submitter?.value === "ask");
    });
    ["#semantic-surface", "#semantic-topic", "#semantic-form"].forEach((selector) => control(selector).addEventListener("change", () => { if (control("#semantic-query").value.trim() && semanticReady) submitSemanticSearch(false); }));

    const linkedQuery = new URLSearchParams(location.search).get("q");
    if (linkedQuery) {
      control("#semantic-query").value = linkedQuery;
      element("#search-summary").textContent = "The linked question is ready. Choose Ask the archive or Find sources only to run it.";
    }
    fetch(`${base}data/manifest.json`).then((response) => response.json()).then((manifest: Manifest) => {
      const semantic = manifest.semantics;
      if (!semantic) return;
      element("#coverage").textContent = `${semantic.coveragePercent.toFixed(1)}% of article versions`;
      element("#document-count").textContent = number.format(semantic.searchDocumentCount ?? semantic.signalCount);
    }).catch(() => { element("#coverage").textContent = "Unavailable"; });
  </script>
</Layout>
